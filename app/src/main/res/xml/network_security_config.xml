<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (http://) connections so that self-hosted Emby / Jellyfin /
  WebDAV media servers on a local network (e.g. http://192.168.1.5:8096) can be
  reached. Android blocks cleartext by default from API 28+, so without this
  every LAN-over-HTTP media server login/fetch fails. This app-wide setting
  permits cleartext for all app traffic, so callers must use HTTPS when the
  configured server supports it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
