<?xml version="1.0" encoding="utf-8"?>
<!--
  Media sources are supplied by the user: IPTV playlists, LAN WebDAV servers
  and direct links may use HTTP on arbitrary hosts. A localhost-only exception
  blocks the OkHttp upstream side of the IJK playback proxy. HTTPS connections
  still use the platform certificate and hostname checks.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
