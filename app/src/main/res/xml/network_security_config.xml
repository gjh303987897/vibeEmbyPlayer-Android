<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (http://) connections so that self-hosted Emby / Jellyfin /
  WebDAV media servers on a local network (e.g. http://192.168.1.5:8096) can be
  reached. Android blocks cleartext by default from API 28+, so without this
  every LAN-over-HTTP media server login/fetch fails. Cleartext-only usage is
  scoped to the app's own media-server traffic; system and third-party traffic
  remains governed by the platform defaults.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
