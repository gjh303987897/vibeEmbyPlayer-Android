<?xml version="1.0" encoding="utf-8"?>
<!--
  Media sources are supplied by the user: IPTV playlists, LAN WebDAV servers
  and direct links may use HTTP on arbitrary hosts. A localhost-only exception
  blocks the OkHttp upstream side of the IJK playback proxy. This is a platform
  allowance, NOT permission to send credentials: the shared OkHttp transport
  requires per-server HTTP consent for credentials/bodies and blocks HTTPS
  downgrades. TSSL WebDAV key backups require HTTPS regardless of that consent.
  HTTPS connections still use certificate and hostname checks.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
