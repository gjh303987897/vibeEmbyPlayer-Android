+/* Public API 23 operating-rate hint, updated on the codec output thread only.
+ * A codec that rejects a resource hint retains ordinary playback. */
+static void update_operating_rate(JNIEnv *env, IJKFF_Pipenode *node)
+{
+    IJKFF_Pipenode_Opaque *opaque = node->opaque;
+    FFPlayer *ffp = opaque->ffp;
+    float speed = vibe_playback_rate(ffp->pf_playback_rate);
+    if (SDL_Android_GetApiLevel() < 23 || speed == opaque->operating_speed) return;
+    AVRational fps = av_guess_frame_rate(ffp->is->ic, ffp->is->video_st, NULL);
+    double operating_rate = vibe_codec_operating_rate(av_q2d(fps), speed);
+    opaque->operating_speed = speed;
+    if (!operating_rate) return;
+    /* The caller owns acodec_mutex (or the single-threaded codec loop). Do not
+     * acquire it from the input thread: the blocking output loop can starve it. */
+    jobject codec = SDL_AMediaCodec_isStarted(opaque->acodec)
+        ? SDL_AMediaCodecJava_getObject(env, opaque->acodec) : NULL;
+    jclass cls = NULL, bundle_cls = NULL;
+    jobject params = NULL;
+    jstring key = NULL;
+    if (!codec) goto done;
+    cls = (*env)->GetObjectClass(env, codec);
+    if (!cls) goto done;
+    jmethodID set = (*env)->GetMethodID(env, cls, "setParameters", "(Landroid/os/Bundle;)V");
+    if (!set) goto done;
+    bundle_cls = (*env)->FindClass(env, "android/os/Bundle");
+    if (!bundle_cls) goto done;
+    jmethodID ctor = (*env)->GetMethodID(env, bundle_cls, "<init>", "()V");
+    if (!ctor) goto done;
+    jmethodID put = (*env)->GetMethodID(env, bundle_cls, "putFloat", "(Ljava/lang/String;F)V");
+    if (!put) goto done;
+    params = (*env)->NewObject(env, bundle_cls, ctor);
+    if (!params) goto done;
+    key = (*env)->NewStringUTF(env, "operating-rate");
+    if (!key) goto done;
+    (*env)->CallVoidMethod(env, params, put, key, (jfloat)operating_rate);
+    if ((*env)->ExceptionCheck(env)) goto done;
+    (*env)->CallVoidMethod(env, codec, set, params);
+    if (!(*env)->ExceptionCheck(env)) ALOGI("MediaCodec operating-rate set: %.3f fps", operating_rate);
+done:
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        ALOGW("MediaCodec operating-rate hint unavailable");
+    }
+    if (key) (*env)->DeleteLocalRef(env, key);
+    if (params) (*env)->DeleteLocalRef(env, params);
+    if (bundle_cls) (*env)->DeleteLocalRef(env, bundle_cls);
+    if (cls) (*env)->DeleteLocalRef(env, cls);
+}
 
