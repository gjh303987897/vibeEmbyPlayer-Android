+JNIEXPORT void JNICALL
+Java_com_vibeplayer_app_player_NativeBitmapSubtitles_setDelay(JNIEnv *env, jobject bridge,
+                                                             jobject player, jlong delay_ms)
+{
+    IjkMediaPlayer *mp = NULL;
+    FFPlayer *ffp;
+    (void)bridge;
+    JNI_CHECK_GOTO(player, env, "java/lang/IllegalArgumentException", "Subtitle player is null", LABEL_RETURN);
+    mp = jni_get_media_player(env, player);
+    JNI_CHECK_GOTO(mp, env, "java/lang/IllegalStateException", "Subtitle player is not initialized", LABEL_RETURN);
+    ffp = mp->ffplayer;
+    JNI_CHECK_GOTO(ffp && ffp->subtitle_mutex, env, "java/lang/IllegalStateException", "Subtitle clock is unavailable", LABEL_RETURN);
+    SDL_LockMutex(ffp->subtitle_mutex);
+    if (delay_ms < -10000) delay_ms = -10000;
+    if (delay_ms > 10000) delay_ms = 10000;
+    if (ffp->subtitle_delay_ms != delay_ms) {
+        ffp->subtitle_delay_ms = delay_ms;
+        /* Invalidate even if several edits return to the old offset before refresh. */
+        ffp->subtitle_render_delay_ms = INT64_MIN;
+        vibe_bitmap_subtitles_clear_l(ffp, 1);
+    }
+    SDL_UnlockMutex(ffp->subtitle_mutex);
+LABEL_RETURN:
+    ijkmp_dec_ref_p(&mp);
+}
