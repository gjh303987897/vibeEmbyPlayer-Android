+JNIEXPORT jobject JNICALL
+Java_com_vibeplayer_app_player_NativeBitmapSubtitles_read(JNIEnv *env, jobject bridge,
+                                                         jobject player, jlong revision)
+{
+    jobject result;
+    IjkMediaPlayer *mp;
+    (void)bridge;
+    if (!player) {
+        jclass exception = (*env)->FindClass(env, "java/lang/IllegalArgumentException");
+        if (exception) {
+            (*env)->ThrowNew(env, exception, "Bitmap subtitle player is null");
+            (*env)->DeleteLocalRef(env, exception);
+        }
+        return NULL;
+    }
+    mp = jni_get_media_player(env, player);
+    if (!mp)
+        return NULL;
+    result = vibe_bitmap_subtitles_read(env, mp->ffplayer, revision);
+    ijkmp_dec_ref_p(&mp);
+    return result;
+}
