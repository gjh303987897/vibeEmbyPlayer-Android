+/* Text and bitmap cues share the playback master clock, including expiration
+ * while video has no next frame. subtitle_mutex also excludes close/seek. */
+static void subtitle_refresh(FFPlayer *ffp)
+{
+    VideoState *is = ffp->is;
+    double clock = get_master_clock(is);
+    SDL_LockMutex(ffp->subtitle_mutex);
+    if (!ffp->subtitle_active || ffp->subtitle_seek_pending || is->seek_req || is->abort_request || isnan(clock))
+        goto done;
+    while (frame_queue_nb_remaining(&is->subpq) > 0) {
+        Frame *sp = frame_queue_peek(&is->subpq);
+        Frame *next = frame_queue_nb_remaining(&is->subpq) > 1 ? frame_queue_peek_next(&is->subpq) : NULL;
+        if (sp->serial != is->subtitleq.serial ||
+            (sp->sub.num_rects && clock > sp->pts + sp->sub.end_display_time / 1000.0) ||
+            (next && next->serial == is->subtitleq.serial && clock >= next->pts + next->sub.start_display_time / 1000.0)) {
+            if (sp->uploaded)
+                vibe_bitmap_subtitles_clear_l(ffp, 1);
+            frame_queue_next(&is->subpq);
+            continue;
+        }
+        if (!sp->uploaded && clock >= sp->pts + sp->sub.start_display_time / 1000.0) {
+            if (sp->sub.format == 0) {
+                vibe_bitmap_subtitles_present_l(ffp, sp);
+            } else {
+                char buffered_text[4096] = { 0 };
+                vibe_bitmap_subtitles_clear_l(ffp, 0);
+                if (sp->sub.num_rects > 0 && sp->sub.rects[0]) {
+                    if (sp->sub.rects[0]->text)
+                        av_strlcpy(buffered_text, sp->sub.rects[0]->text, sizeof(buffered_text));
+                    else if (sp->sub.rects[0]->ass)
+                        parse_ass_subtitle(sp->sub.rects[0]->ass, buffered_text);
+                }
+                ffp_notify_msg4(ffp, FFP_MSG_TIMED_TEXT, 0, 0, buffered_text, strlen(buffered_text) + 1);
+            }
+            sp->uploaded = 1;
+        }
+        break;
+    }
+done:
+    SDL_UnlockMutex(ffp->subtitle_mutex);
+}
